# Copy to .env and fill in. The server reads these from its environment:
#   docker compose: env_file in docker-compose.yml loads them
#   systemd:        EnvironmentFile=/etc/boxloft/env (see deploy/boxloft.service)
#   by hand:        set -a; . ./.env; set +a; python3 backend/server.py

# Where people open the app. eBay and Amazon send people back here after they connect an account.
BOXLOFT_PUBLIC_URL=https://wms.example.com
# Docker only: the address Caddy serves. A domain (DNS A record pointing at this server) gets HTTPS by itself.
# http://localhost tries it on your own computer (plain HTTP, so the phone camera scanner is off).
DOMAIN=wms.example.com

# Your business
BOXLOFT_APP_NAME=Boxloft
BOXLOFT_SITE_NAME=Main warehouse
BOXLOFT_PLACE=
BOXLOFT_TZ=America/New_York
# BOXLOFT_TZ_LABEL=ET

# Data folder (wms.db, auth.db, photos, nightly backups). Docker mounts a volume at /data instead.
BOXLOFT_DATA=./data
# The server listens on 127.0.0.1 at this port (Caddy in front). BOXLOFT_DEV=1 is for trying it only:
# plain-HTTP cookie and listening on 0.0.0.0, so anyone on your network can reach it.
BOXLOFT_PORT=5101
# BOXLOFT_DEV=1

# Product lookup by barcode. Optional: without it, UPCitemdb's free tier (about 100 lookups a day) still works.
KEEPA_API_KEY=

# AI (optional). Store emails need Anthropic, OpenAI or TypeSafe. Photos need Gemini, Anthropic or OpenAI.
# Leave BOXLOFT_AI_PROVIDER empty to use the first key that is set.
BOXLOFT_AI_PROVIDER=
BOXLOFT_PHOTO_PROVIDER=
BOXLOFT_AI_MODEL=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
TYPESAFE_API_KEY=
GEMINI_API_KEY=

# Marketplace keys (Amazon, eBay, Walmart, Gmail) don't go here.
# An admin pastes them in the app (Settings, Connections). They're saved in DATA/secrets/connections.json, mode 600.
